# ============================================
# Streamer Java (Kafka Streams) - Ejemplo de Variables de Entorno
# ============================================
# Configuración para la aplicación de agregación con Kafka Streams

# ────────────────────────────────────────────
# Kafka Streams Configuration
# ────────────────────────────────────────────
KAFKA_BOOTSTRAP_SERVERS=localhost:9092

# Application ID único para este consumer group
KAFKA_APPLICATION_ID=gamc-streams-app

# ────────────────────────────────────────────
# Topics de Entrada (datos crudos)
# ────────────────────────────────────────────
KAFKA_TOPIC_AIR_INPUT=sensores.air
KAFKA_TOPIC_NOISE_INPUT=sensores.noise
KAFKA_TOPIC_UNDERGROUND_INPUT=sensores.underground

# ────────────────────────────────────────────
# Topics de Salida (agregados 1 minuto)
# ────────────────────────────────────────────
KAFKA_TOPIC_AIR_OUTPUT=sensores.air.avg1m
KAFKA_TOPIC_NOISE_OUTPUT=sensores.noise.avg1m
KAFKA_TOPIC_UNDERGROUND_OUTPUT=sensores.underground.avg1m

# ────────────────────────────────────────────
# Window Configuration
# ────────────────────────────────────────────
# Tamaño de ventana en milisegundos (60000 = 1 minuto)
WINDOW_SIZE_MS=60000

# Grace period para datos tardíos (30000 = 30 segundos)
WINDOW_GRACE_MS=30000

# ────────────────────────────────────────────
# Streams Processing Configuration
# ────────────────────────────────────────────
# Intervalo de commit (ms)
COMMIT_INTERVAL_MS=5000

# Cache size (bytes)
CACHE_MAX_BYTES_BUFFERING=10485760

# Número de threads de procesamiento
NUM_STREAM_THREADS=2

# ────────────────────────────────────────────
# State Store Configuration
# ────────────────────────────────────────────
# Directorio para state stores locales
STATE_DIR=./kafka-streams-state

# ────────────────────────────────────────────
# Logging
# ────────────────────────────────────────────
LOG_LEVEL=INFO

# ────────────────────────────────────────────
# Notas de Uso
# ────────────────────────────────────────────
# Ejecutar con variables de entorno:
#   export KAFKA_BOOTSTRAP_SERVERS=localhost:9092
#   java -jar streamer.jar
#
# O ver: src/main/resources/application.properties
