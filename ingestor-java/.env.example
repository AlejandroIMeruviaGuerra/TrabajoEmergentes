# ============================================
# Ingestor Java - Ejemplo de Variables de Entorno
# ============================================
# Estas variables pueden configurarse como variables de entorno del sistema
# o pasarse como argumentos al ejecutar el JAR

# ────────────────────────────────────────────
# Kafka Configuration
# ────────────────────────────────────────────
KAFKA_BOOTSTRAP_SERVERS=localhost:9092

# Topics de destino
KAFKA_TOPIC_AIR=sensores.air
KAFKA_TOPIC_NOISE=sensores.noise
KAFKA_TOPIC_UNDERGROUND=sensores.underground

# ────────────────────────────────────────────
# Producer Configuration
# ────────────────────────────────────────────
KAFKA_ACKS=1
KAFKA_LINGER_MS=20
KAFKA_BATCH_SIZE=131072
KAFKA_RETRIES=3
KAFKA_RETRY_BACKOFF_MS=1000

# ────────────────────────────────────────────
# CSV Files Configuration
# ────────────────────────────────────────────
# Rutas a los archivos CSV de entrada
CSV_AIR_PATH=./data/air_quality.csv
CSV_NOISE_PATH=./data/noise.csv
CSV_UNDERGROUND_PATH=./data/underground.csv

# ────────────────────────────────────────────
# Processing Configuration
# ────────────────────────────────────────────
# Tamaño de lote para procesamiento
BATCH_SIZE=1000

# Logging level (INFO, DEBUG, WARN, ERROR)
LOG_LEVEL=INFO

# ────────────────────────────────────────────
# Notas de Uso
# ────────────────────────────────────────────
# Opción 1 - Variables de entorno:
#   export KAFKA_BOOTSTRAP_SERVERS=localhost:9092
#   java -jar ingestor.jar
#
# Opción 2 - Archivo application.properties:
#   Ver: src/main/resources/application.properties
#
# Opción 3 - Argumentos de línea de comandos:
#   java -jar ingestor.jar --kafka.bootstrap.servers=localhost:9092
