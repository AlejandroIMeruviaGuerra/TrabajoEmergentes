# ============================================
# Backend - Ejemplo de Variables de Entorno
# ============================================
# Copia este archivo a .env y configura con tus valores reales
# IMPORTANTE: NO commitear el archivo .env con credenciales reales

# ────────────────────────────────────────────
# Servidor
# ────────────────────────────────────────────
PORT=4000

# ────────────────────────────────────────────
# MySQL (Base de datos relacional)
# ────────────────────────────────────────────
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASS=tu_password_mysql
DB_NAME=emergentes_db

# ────────────────────────────────────────────
# MongoDB (Base de datos NoSQL)
# ────────────────────────────────────────────
# Formato: mongodb://user:pass@host:port/database
# O para Atlas: mongodb+srv://user:pass@cluster.mongodb.net/database
MONGO_URI=mongodb://localhost:27017/emergentes_nosql

# Configuración del pool de conexiones
MONGO_MAX_POOL=30
MONGO_MIN_POOL=5
MONGO_SSTM_MS=10000
MONGO_W=1

# ────────────────────────────────────────────
# Kafka
# ────────────────────────────────────────────
# Brokers separados por coma (ej: broker1:9092,broker2:9092)
KAFKA_BROKERS=localhost:9092

# ────────────────────────────────────────────
# Autenticación (JWT)
# ────────────────────────────────────────────
# Genera un secreto fuerte: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=tu_secreto_super_seguro_aqui_cambiar
JWT_EXPIRES=24h

# ────────────────────────────────────────────
# Uploads (Subida de archivos CSV)
# ────────────────────────────────────────────
UPLOAD_DIR=./uploads
CHUNK_SIZE_MB=5

# ────────────────────────────────────────────
# Entorno
# ────────────────────────────────────────────
NODE_ENV=development
